{
  "expo": {
    "name": "Girnar Shilp Vyapar",
    "slug": "girnar-shilp-vyapar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "girnarshilp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.girnarshilp.vyapar"
    },
    "android": {
      "package": "com.girnarshilp.vyapar"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "girnar-shilp-enterprise"
      }
    }
  }
}
